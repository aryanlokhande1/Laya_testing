# PostgreSQL template: copy to .env.postgres and fill in values LOCALLY.
# Never commit a completed credential file. PG process variables take precedence.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=laya_testing
PGUSER=YOUR_LOCAL_POSTGRES_ROLE
PGPASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD

# Ollama runners read process environment variables, not dotenv files.
# Optional PowerShell setting; do not add this key to .env.postgres:
# $env:OLLAMA_BASE_URL = 'http://127.0.0.1:11434'
